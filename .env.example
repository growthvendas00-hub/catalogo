# Deixe vazio para usar o modo demonstração com 10 peças locais.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente no servidor. Use a Secret Key moderna (sb_secret_...), nunca NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Checkout Pro. O Access Token é secreto e fica somente no servidor.
MERCADO_PAGO_ACCESS_TOKEN=
# O Checkout Pro usa sempre o init_point retornado pelo Mercado Pago.
# O ambiente (teste ou real) é determinado pela credencial configurada.
# Adicione depois de cadastrar /api/webhooks/mercado-pago no painel do Mercado Pago.
MERCADO_PAGO_WEBHOOK_SECRET=

# Opcional: URL pública completa para metadata/Open Graph.
# Se ficar vazia, usa localhost no desenvolvimento e a URL automática da Vercel no deploy.
NEXT_PUBLIC_SITE_URL=
